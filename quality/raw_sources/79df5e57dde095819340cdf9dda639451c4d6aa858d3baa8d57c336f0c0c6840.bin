                  <div>

                     <div style="clear:both;margin-top:8.0pt;position:relative;width:100%;">

                        <div style="float:left;line-height:8pt;text-align:left;width:4.45pt;"><font style="color:#000000;font-family:Arial;font-size:8pt;">1</font></div>

                        <div style="float:left;line-height:8pt;margin-left:7.55pt;text-align:left;width:319.00pt;"><font style="color:#000000;font-family:Arial;font-size:8pt;">The expense information shown in the table has been restated to reflect current fees.</font></div>
