                           <td style="background-color:#FFFFFF;padding-bottom:1.5pt;padding-top:1.875pt;vertical-align:Bottom;white-space:nowrap;width:80.01pt;">

                              <div style="line-height:10pt;margin-left:6pt;margin-right:6pt;text-align:right;width:68.01pt;">

                                 <div style="display:flex;margin-right:auto;width:17.56pt;">

                                    <div style="display:flex;white-space:nowrap;width:17.56pt;"><font style="color:#000000;font-family:Arial;font-size:8pt;width:17.56pt;">0.03</font></div>

                                    <div style="display:flex;"><font style="color:#000000;font-family:Arial;font-size:8pt;width:auto;">%</font></div>
                                 </div>
                              </div>
                           </td>

                           <td style="background-color:#FFFFFF;padding-bottom:1.5pt;padding-top:1.875pt;vertical-align:Bottom;width:91.78pt;">

                              <div style="line-height:10pt;text-align:left;">

                                 <div style="margin-left:6pt;text-align:Left;white-space:nowrap;"><font style="color:#000000;font-family:Arial;font-size:8pt;margin-left:0.0pt;">0.02%</font></div>
                              </div>
                           </td>
                        </tr>
                     </table>
