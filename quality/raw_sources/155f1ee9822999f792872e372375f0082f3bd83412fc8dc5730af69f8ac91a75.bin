<td style="background-color:azure;border-bottom:0.5pt solid #000000;border-right:0.5pt solid #000000;padding-bottom:1.625pt;padding-top:1.625pt;vertical-align:Top;width:126pt"> <div style="line-height:13.0pt;text-align:left"> <div style="margin-right:5.75pt;text-align:Left;white-space:nowrap"><span style="color:#000000;font-family:Arial Narrow;font-size:10pt;margin-left:0.0pt">Key concepts</span></div> </div> </td>
