            this.hasDistributions = Object.values(fundData.distributions).some(value => value && Object.keys(value).length > 0);

            const date = new Date(fundData.analysisDate.performance);
            const asOfYear = date.getFullYear();
            const isAsOfDec31 = date.getMonth() === 11 && date.getDate() === 31;

            this.tenYearsAgo = asOfYear - 10;
            this.distributionsAsOf = this.convertDate(fundData.analysisDate.performance);

            const fullDistributions = {};
            for (let year = this.tenYearsAgo; year <= asOfYear; year++) {
                fullDistributions[year] = '';
            }

            Object.entries(fundData.distributions).forEach(([year, details]) => {
                const parsedYear = parseInt(year);
                if (parsedYear >= this.tenYearsAgo && parsedYear <= asOfYear) {
                    fullDistributions[year] = details;
                }
            });

            this.distributions = fullDistributions;

            this.distributionsDate = Object.keys(fullDistributions)
                .map(year => +year === asOfYear && !isAsOfDec31 ? 'YTD' : year)
                .sort((a, b) => {
                    if (a === 'YTD') return -1;
                    if (b === 'YTD') return 1;
                    return b.localeCompare(a, undefined, {numeric: true});
                });
        }
    }).mount('#app_id_1402531')
