   changeFund(e) {
          if (this.isPageLoad) {
                this.isPageLoad = false;
                return;
            }
            const fund = e;

            if (typeof fund === "string" && fund.startsWith("RBF")) {
                location.href = `/en/ca/products/mutual-funds/${fund}/detail/`;
            } else if (typeof fund === "string") {
                location.href = `/en/ca/products/etfs/${fund}/detail/`;
            }
        },



