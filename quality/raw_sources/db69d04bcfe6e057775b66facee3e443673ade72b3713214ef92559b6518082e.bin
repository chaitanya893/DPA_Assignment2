            processData(distributions, key) {
                return Object.entries(distributions)
                        .map(([year, details]) => {
                            const value = details[key];
                            return (value == null || value === 0) ? "-" : formatNumber(value, 'en', 2);
                        })
                        .reverse();
            },
            convertDate (date) {
                return new Date(date).toLocaleString("en-us", {
                    year: 'numeric',
                    month: 'numeric',
                    day: 'numeric',
                    timeZone: 'UTC'
                });
            },
        },
