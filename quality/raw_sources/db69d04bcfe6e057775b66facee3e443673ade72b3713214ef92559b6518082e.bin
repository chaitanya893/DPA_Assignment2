				    <div id="app_id_9139919" v-cloak>
    <Teleport to="#equiltySingleRegionMF-top-10-holdings-mf-slot" >
		<article :class="{'section-block section-block-sm': templateCheck}" data-location="fund top 10 holdings" v-if='hasTopUnderlyingHoldings'>
            <div class="text-sm-right mb-1" :class="{'mt-1': templateCheck}">
	        
	        	        
			    
				    <rbc-button
					    outline
					    size="small"
					    @click="downloadHoldingsQuarterlyCSV"
				    >Download quarterly holdings CSV</rbc-button>

		        

		    	                    </div>
		<header class="row section-block-header">
            			            			                        			<span class="col-sm text-sm-right footnote mb-half mb-sm-0">As of {{ top10HoldingsAsOf }}</span>
		</header>
		<table class="table table-transparent table-striped table-border-horizontal">
            <thead>
            <tr>
                <th>
                    Holdings
                </th>
                <th class="text-right">
                    Assets
                </th>
            </tr>
            </thead>
            <tbody>
            <tr v-for="holding in top10HoldingsData.slice(0,10)">
                <td v-if="holding.key === 'RUSSEL Fixed Income Pool - Series O'">
                    Russell Fixed Income Pool – Series O
                </td>
                <td v-else>{{ holding.key }}</td>
                <td class="text-right">
                    {{ holding.displayValue }}
                </td>
            </tr>
            </tbody>
            <tfoot>
            <tr class="strong">
                <td>
                    {{ totalPercentCaption }}
                </td>
                <td class="text-right">
                    {{ top10HoldingsTopTotal }}
                </td>
            </tr>
            </tfoot>
        </table>
        </article>
    </Teleport>
</div>



<script type="module">
    import {formatCurrency} from "utils";
    import {createApp} from 'vue'
    import {RbcButton} from 'wm'

    const EQUITY_LONG_SHORT_FUNDS = ['RBF941', 'RBF441', 'RBF8257', 'RBF8258', 'RBF9941', 'RBF9441', 'RBF1441', 'RBF2941', 'RBF8358'];

    createApp({
        components: {"rbc-button": RbcButton},
        data() {
            return {
                top10HoldingsAsOf: '',
                top10HoldingsData: [],
                top10HoldingsTopTotal: '',
                topHoldingsQuarterlyPreviousData: [],
                templateCheck: 'equity-singleregion' === 'moneymarket',
                topHoldingsQuarterly:null,
                topHoldingsQuarterly_fr:null,
                topHoldingsQuarterlyAsOf:null,
                topHoldingsQuarterlyPrevious:null,
                topHoldingsQuarterlyPrevious_fr:null,
                topHoldingsQuarterlyPreviousAsOfCSV: null,
                topHoldingsQuarterlyPreviousAsOf:null,
                isEquityLongShortFund: false,
                fundCode: ''
            };
        },
        computed: {
            hasTopUnderlyingHoldings() {
                return this.top10HoldingsData && !this.isEmpty(this.top10HoldingsData);
            },
            sectionHeaderText() {
                if (this.isEquityLongShortFund) {
                    return "Top 10 long positions";
                }
                return "Top 10 holdings";
            },
            totalPercentCaption() {
                if (this.isEquityLongShortFund) {
                    return "Total % of top 10 long positions";
                }
                return "Total % of top 10 holdings";
            }
        },
        methods: {
            formatTop10(data) {
                if (!data || typeof data !== 'object') {
                    return [];
                }
                return Object.keys(data)
                    .sort((valA, valB) => data[valB] - data[valA])
                    .map((key) => {
                        const value = data[key];
                        return {
                            key,
                            value,
                            displayValue: formatCurrency(value, 'en', 1, "%")
                        };
                    });
            },
            isEmpty(value) {
                if (Array.isArray(value)) {
                    return value.length === 0;
                }
                if (typeof value === 'object' && value !== null) {
                    return Object.keys(value).length === 0;
                }
                return !value;
            },
            downloadData(blob, filename) {
                if (blob) {
                    const element = document.createElement('a');

                    if (navigator.msSaveOrOpenBlob) {
                        navigator.msSaveOrOpenBlob(blob, filename);
                    } else {
                        element.href = window.URL.createObjectURL(blob);

                        element.download = filename;

                        element.style.display = 'none';
                        document.body.appendChild(element);

                        element.click();

                        document.body.removeChild(element);
                    }
                }
            },
