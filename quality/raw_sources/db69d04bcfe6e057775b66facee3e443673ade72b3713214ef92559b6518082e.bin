            const rbcFundCode = fundData?.rbcFundCode; 
            this.ticker = fundData?.rbcFundCode;
            this.growth10kDataLengthFDS = Object.keys(fundData.growth10k).length;
            this.growth10kDatesFDS = Object.keys(fundData.growth10k).sort((valA, valB) => new Date(valA) - new Date(valB));
            this.growth10kAsOfFDS = this.convertDate(this.growth10kDatesFDS[this.growth10kDataLengthFDS - 1]);
            this.containYearBefore = fundData !== null && this.growth10kDataLengthFDS > 0 && this.growth10kDatesFDS.some(date => date.includes("2023-"));
    
            this.$nextTick(() => {
                this.fundFormatDataGrowth10kFDS(fundData, rbcFundCode)
            });}
    }).mount('#app_id_3804401')
</script>

                <div id="app_id_8484917" v-cloak>
        <Teleport to="#best-worth-mf-slot" >
<article class="section-block section-block-sm" data-location="fund bestworst">
		<header class="row section-block-header">
			<h3 class="col-sm">Highest/lowest returns (%)</h3>
			<span class="col-sm text-sm-right footnote mb-half mb-sm-0">As of {{ growth10kAsOf }}</span>
		</header>
		<div id="bestWorst">
			<div class="table-responsive">
			<table class="text-right table table-compact table-border-horizontal table-transparent">
				 <thead>
					<tr>
						<th aria-hidden="true"></th>
						<th class="table-header-group table-highlight" colspan="2">1 yr</th>
						<th class="table-header-group" colspan="2">3 yr</th>
						<th class="table-header-group table-highlight" colspan="2">5 yr</th>
						<th class="table-header-group" colspan="2">10 yr</th>
					</tr>
					<tr>
						<th aria-hidden="true"></th>
						<th class="text-right table-highlight table-border-left">Ended</th>
						<th class="text-right table-highlight table-border-right">Return</th>
						<th class="text-right">Ended</th>
						<th class="text-right">Return</th>
						<th class="text-right table-highlight table-border-left">Ended</th>
						<th class="text-right table-highlight table-border-right">Return</th>
						<th class="text-right">Ended</th>
						<th class="text-right">Return</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<th class="nowrap text-left">Highest</th>
						<td class="nowrap table-highlight table-border-left">{{ bestWorstdisplayDate(bestWorstBest['1Yr'].end) }}</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstBest['1Yr'].value) }}</td>
						<td class="nowrap">{{ bestWorstdisplayDate(bestWorstBest['3Yr'].end) }}</td>
						<td class="nowrap">{{ displayNumber(bestWorstBest['3Yr'].value) }}</td>
						<td class="nowrap table-highlight table-border-left">{{ bestWorstdisplayDate(bestWorstBest['5Yr'].end) }}</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstBest['5Yr'].value) }}</td>
						<td class="nowrap">{{ bestWorstdisplayDate(bestWorstBest['10Yr'].end) }}</td>
						<td class="nowrap">{{ displayNumber(bestWorstBest['10Yr'].value) }}</td>
					</tr>
					<tr>
						<th class="nowrap text-left">Lowest</th>
						<td class="nowrap table-highlight table-border-left">{{ bestWorstdisplayDate(bestWorstWorst['1Yr'].end) }}</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstWorst['1Yr'].value) }}</td>
						<td class="nowrap">{{ bestWorstdisplayDate(bestWorstWorst['3Yr'].end) }}</td>
						<td class="nowrap">{{ displayNumber(bestWorstWorst['3Yr'].value) }}</td>
						<td class="nowrap table-highlight table-border-left">{{ bestWorstdisplayDate(bestWorstWorst['5Yr'].end) }}</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstWorst['5Yr'].value) }}</td>
						<td class="nowrap">{{ bestWorstdisplayDate(bestWorstWorst['10Yr'].end) }}</td>
						<td class="nowrap">{{ displayNumber(bestWorstWorst['10Yr'].value) }}</td>
					</tr>
					<tr>
						<th class="nowrap text-left">Average</th>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstcalculateAnnualized(bestWorstaverage(bestWorstAvg['1Yr']),1)) }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ displayNumber(bestWorstcalculateAnnualized(bestWorstaverage(bestWorstAvg['3Yr']),3)) }}</td>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstcalculateAnnualized(bestWorstaverage(bestWorstAvg['5Yr']),5)) }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ displayNumber(bestWorstcalculateAnnualized(bestWorstaverage(bestWorstAvg['10Yr']),10)) }}</td>
					</tr>
					<tr>
						<th class="nowrap text-left">No. of periods</th>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ bestWorstAvg['1Yr'].length }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ bestWorstAvg['3Yr'].length }}</td>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ bestWorstAvg['5Yr'].length }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ displayNumber(bestWorstAvg['10Yr'].length, 0) }}</td>
					</tr>
					<tr>
						<th class="nowrap text-left">% positive</th>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstpercentOfPositive(bestWorstAvg['1Yr'])) }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ displayNumber(bestWorstpercentOfPositive(bestWorstAvg['3Yr'])) }}</td>
						<td class="nowrap table-highlight table-border-left">-</td>
						<td class="nowrap table-highlight table-border-right">{{ displayNumber(bestWorstpercentOfPositive(bestWorstAvg['5Yr'])) }}</td>
						<td class="nowrap">-</td>
						<td class="nowrap">{{ displayNumber(bestWorstpercentOfPositive(bestWorstAvg['10Yr'])) }}</td>
					</tr> 
				</tbody>
			</table>
			</div>
		</div>
		<footer class="footnote pt-half">*Highest/lowest returns (%) is based on data since inception of the fund.</footer>
	</article>
</Teleport>
</div>



<script type="module">	
	import {createApp} from 'vue';
	
	createApp({
		data() {
			return {
				bestWorstBest: {
					'1Yr': {end: "", value: null},
					'3Yr': {end: "", value: null},
					'5Yr': {end: "", value: null},
					'10Yr': {end: "", value: null}
				},
				bestWorstWorst: {
					'1Yr': {end: "", value: null},
					'3Yr': {end: "", value: null},
					'5Yr': {end: "", value: null},
					'10Yr': {end: "", value: null}
				},
				bestWorstAvg: {
					'1Yr': [],
					'3Yr': [],
					'5Yr': [],
					'10Yr': []
				},
				growth10kAsOf: '',
				growth10kDataLength: ''
				
			};
		},
		
		methods: {
			bestWorstFormatData(data) {
				this.computeBestWorst(data);
			},
			bestWorstcalculateAnnualized(value, numberOfYear) {
				return (Math.pow(value, (1 / numberOfYear)) - 1) * 100;
			},
			bestWorstaverage(arr) {
				return (arr.reduce(function (a, b) {
					return a + b
				}, 0) / arr.length)
			},
			bestWorstpercentOfPositive(arr) {
				return ((arr.reduce(function (a, b) {
					if (b > 1) {
						return a + 1
					} else {
						return a
					}
				}, 0) / arr.length) * 100)
			},
			bestWorstdisplayDate(d) {
				return d.substring(5, 7) + '-' + d.substring(0, 4);
			},
			computeBestWorst(growthOf10K) {
				var _self = this;
				this.growth10kDates = Object.keys(growthOf10K).sort(function (valA, valB) {
					return new Date(valA) - new Date(valB)
				});
				this.growth10kDataLength = Object.keys(growthOf10K).length;
				this.growth10kDates.forEach(function (key, i) {
					if (i == 0) growthOf10K[_self.growth10kDates[i]].val = 10000;
					else growthOf10K[_self.growth10kDates[i]].val = growthOf10K[_self.growth10kDates[i - 1]].val + (growthOf10K[_self.growth10kDates[i - 1]].val * (growthOf10K[_self.growth10kDates[i]].var / 100));
				});
				
				this.growth10kDates.forEach(function (key, i) {
					if (i > 11) {
						var newValue1Yr = (growthOf10K[_self.growth10kDates[i]].val - growthOf10K[_self.growth10kDates[i - 12]].val) / growthOf10K[_self.growth10kDates[i - 12]].val + 1;
						var newValue1YrNonAnnualized = newValue1Yr;
						newValue1Yr = _self.bestWorstcalculateAnnualized(newValue1Yr, 1);
						if (
								(_self.bestWorstBest['1Yr'].end != "" && _self.bestWorstBest['1Yr'].value != null && _self.bestWorstBest['1Yr'].value < newValue1Yr) ||
								(_self.bestWorstBest['1Yr'].end == "" && _self.bestWorstBest['1Yr'].value == null)
						) {
							_self.bestWorstBest['1Yr'].end = key;
							_self.bestWorstBest['1Yr'].value = newValue1Yr;
						}
						if (
								(_self.bestWorstWorst['1Yr'].end != "" && _self.bestWorstWorst['1Yr'].value != null && _self.bestWorstWorst['1Yr'].value > newValue1Yr) ||
								(_self.bestWorstWorst['1Yr'].end == "" && _self.bestWorstWorst['1Yr'].value == null)
						) {
							_self.bestWorstWorst['1Yr'].end = key;
							_self.bestWorstWorst['1Yr'].value = newValue1Yr;
						}
						_self.bestWorstAvg['1Yr'].push(newValue1YrNonAnnualized);
					}
					if (i > 35) {
						var newValue3Yr = (growthOf10K[_self.growth10kDates[i]].val - growthOf10K[_self.growth10kDates[i - 36]].val) / growthOf10K[_self.growth10kDates[i - 36]].val + 1;
						var newValue3YrNonAnnualized = newValue3Yr;
						newValue3Yr = _self.bestWorstcalculateAnnualized(newValue3Yr, 3);
						if (
								(_self.bestWorstBest['3Yr'].end != "" && _self.bestWorstBest['3Yr'].value != null && _self.bestWorstBest['3Yr'].value < newValue3Yr) ||
								(_self.bestWorstBest['3Yr'].end == "" && _self.bestWorstBest['3Yr'].value == null)
						) {
							_self.bestWorstBest['3Yr'].end = key;
							_self.bestWorstBest['3Yr'].value = newValue3Yr;
						}
						if (
								(_self.bestWorstWorst['3Yr'].end != "" && _self.bestWorstWorst['3Yr'].value != null && _self.bestWorstWorst['3Yr'].value > newValue3Yr) ||
								(_self.bestWorstWorst['3Yr'].end == "" && _self.bestWorstWorst['3Yr'].value == null)
						) {
							_self.bestWorstWorst['3Yr'].end = key;
							_self.bestWorstWorst['3Yr'].value = newValue3Yr;
						}
						_self.bestWorstAvg['3Yr'].push(newValue3YrNonAnnualized);
					}
					if (i > 59) {
						var newValue5Yr = (growthOf10K[_self.growth10kDates[i]].val - growthOf10K[_self.growth10kDates[i - 60]].val) / growthOf10K[_self.growth10kDates[i - 60]].val + 1;
						var newValue5YrNonAnnualized = newValue5Yr;
						newValue5Yr = _self.bestWorstcalculateAnnualized(newValue5Yr, 5);
						if (
								(_self.bestWorstBest['5Yr'].end != "" && _self.bestWorstBest['5Yr'].value != null && _self.bestWorstBest['5Yr'].value < newValue5Yr) ||
								(_self.bestWorstBest['5Yr'].end == "" && _self.bestWorstBest['5Yr'].value == null)
						) {
							_self.bestWorstBest['5Yr'].end = key;
							_self.bestWorstBest['5Yr'].value = newValue5Yr;
						}
						if (
								(_self.bestWorstWorst['5Yr'].end != "" && _self.bestWorstWorst['5Yr'].value != null && _self.bestWorstWorst['5Yr'].value > newValue5Yr) ||
								(_self.bestWorstWorst['5Yr'].end == "" && _self.bestWorstWorst['5Yr'].value == null)
						) {
							_self.bestWorstWorst['5Yr'].end = key;
							_self.bestWorstWorst['5Yr'].value = newValue5Yr;
						}
						_self.bestWorstAvg['5Yr'].push(newValue5YrNonAnnualized);
					}
					if (i > 119) {
