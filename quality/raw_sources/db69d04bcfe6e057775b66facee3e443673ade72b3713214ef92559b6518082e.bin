        <div id="app_id_5324723" v-cloak>
        <Teleport to="#details-card-mf-slot">
				<component 
					:is="!isMd ? 'rbc-expandable': 'div'" 
                    :arrow="!isMd"
					class="sidebar-card"
                    :class="{'mb-2': isMd}"
					data-location="sidebar details"
				>   
                    <template #trigger>
				<h3> Details</h3>
					</template>
					<rbc-card 
						:class="{'mb-0': isMd}"
					>
                                            <div v-if='isMd' class="list-divider list-divider-condensed" data-test="fund-facts-list">
                        <div  data-test="fund-facts-item">
                            <div class="row">
                                <div class="col">
                                                                        <h3  > Details</h3>
                                </div>
                            </div>
                        </div>
                    </div>
						<div class="list-divider list-divider-condensed">
							<div class="list-divider-item">
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">Risk rating</span>
                                         <rbc-tooltip
                                                trigger-label="Tooltip Risk rating"
                                                icon="info-circle"
                                                size='small'
                                                text="All investments involve risk. The value of the fund can go down as well as up and you could lose money. The risk of this fund has been rated based on the historical volatility of the fund’s returns using industry standard risk rating guidelines. For more information about the specific risks of this fund , see the fund’s prospectus."
                                        ></rbc-tooltip>
									</div>
									<div class="col-12">
										<ul class="list-box">
											<li 
												:class="{active: fundRisk === 'low'}"
												class="list-box-item"
											>
												Low
											</li>
											<li 
												:class="{active: fundRisk === 'lowtomedium'}"
												class="list-box-item"
											>
												Low to med
											</li>
											<li 
												:class="{active: fundRisk === 'medium'}"
												class="list-box-item"
											>
												Med
											</li>
											<li 
												:class="{active: fundRisk === 'mediumtohigh'}"
												class="list-box-item"
											>
												Med to high
											</li>
											<li 
												:class="{active: fundRisk === 'high'}"
												class="list-box-item"
											>
												High
											</li>
										</ul>
									</div>
								</div>
							</div>
							<div class="list-divider-item">
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Series
										</span>
									</div>
									<div class="col-4 text-right">
										{{ fundSeries }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundNAV"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-6">
										<span class="list-text-subheader">
											NAV $
										</span>
									</div>
									<div class="col-6 text-right">
										{{ fundNAV }}<br>
										<span class="list-text-small">
											{{ priceAsOf }}
										</span>
									</div>
								</div>
							</div>
							<div 
								v-if="inceptionDate"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Inception date
										</span>
									</div>
									<div class="col-4 text-right nowrap">
										{{ inceptionDate }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundNetAsset"
								class="list-divider-item"
							>
								
                                <div 
								v-if="rbcFundCode != 'RBF9999'"
								class="row"
							>
									<div class="col-6">
										<span class="list-text-subheader">
											Net asset $
										</span>
									</div>
									<div class="col-6 text-right">
										{{ fundNetAsset }}<br>
										<span class="list-text-small">
											{{ netAssetsAsOf }}
										</span>
									</div>
								</div>
							</div>
							<div 
								v-if="fundMER"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">MER %</span>
                                         <rbc-tooltip
                                                trigger-label="Tooltip MER"
                                                size='small'
                                                icon="info-circle"
                                                text="As reported in the fund's most recent Semi-Annual or Annual Management Report of Fund Performance. MER includes all management fees and GST/HST paid by the fund for the period, and includes the fund’s proportionate share of the MER, if any, of any underlying fund in which the fund has invested."
                                        ></rbc-tooltip>
									</div>
									<div class="col-4 text-right">
										{{ fundMER }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundManagementFees"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">Management fee %</span>
                                        <rbc-tooltip
                                                trigger-label="Tooltip Management fee"
                                                size='small'
                                                icon="info-circle"
                                                text="The annual fee payable by the fund and/or any underlying ETF(s) to the investment fund manager and/or its affiliates for acting as trustee and/or manager of the fund/ETF(s)."
                                        ></rbc-tooltip>
									</div>
									<div class="col-4 text-right">
										{{ fundManagementFees }}
									</div>
								</div>
							</div>
														<div 
								v-if="fundIncomeDistribution"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Income distribution
										</span>
									</div>
									<div class="col-4 text-right">
										{{ fundIncomeDistribution }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundCapitalGainsDistribution && fundCapitalGainsDistribution != 'fund.None'"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Capital gains distribution
										</span>
									</div>
									<div class="col-4 text-right">
										{{ fundCapitalGainsDistribution }}
									</div>
								</div>
							</div>
                            
							<div 
								v-if="cifscCategory"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-6">
										<span class="list-text-subheader">
											Fund category<BR>(CIFSC)
										</span>
									</div>
									<div class="col-6 text-right">
										{{ cifscCategory }}
									</div>
								</div>
							</div>
                            
							<div 
								v-if="fundLoadStructure"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Load structure
										</span>
									</div>
									<div class="col-4 text-right">
										{{ fundLoadStructure }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundMinimumInvestment"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-6">
										<span class="list-text-subheader">
											Minimum investment&nbsp;$
										</span>
									</div>
									<div class="col-6 text-right">
										{{ fundMinimumInvestment }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundSubsequentInvestment"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-6">
										<span class="list-text-subheader">
											Subsequent investment&nbsp;$
										</span>
									</div>
									<div class="col-6 text-right">
										{{ fundSubsequentInvestment }}
									</div>
								</div>
							</div>
							<div 
								v-if="fundSalesStatus"
								class="list-divider-item"
							>
								<div class="row">
									<div class="col-8">
										<span class="list-text-subheader">
											Sales status
										</span>
									</div>
									<div class="col-4 text-right">
										{{ fundSalesStatus }}
									</div>
								</div>
							</div>
						</div>
					</rbc-card >
				</component>
</Teleport>
</div>



