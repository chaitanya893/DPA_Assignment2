<div id="app_id_2208427" v-cloak>
    <Teleport to="#equilty-single-region-mf-slot">
  <div class="row mt-md-1">
            <div class="col-lg-12"  v-if="hasEquitySectorAllocation">
                <div id="balancedMFequilty-characteristics-mf-slot"></div>
            </div>


            <div class="col-lg-12" v-if="hasTopHoldings || hasTopUnderlyingHoldings">
                <rbc-tab toggle-show data-location='Top 10 holdings table'>

                    <rbc-tab-content v-if="hasTopHoldings" name='Top 10 holdings'>
                        <div id="equiltySingleRegionMF-top-10-holdings-mf-slot"></div>
                    </rbc-tab-content>

                 
                </rbc-tab>
            </div>


        </div>
    </Teleport>
</div>

<script type="module">

    import  {createApp} from 'vue';
    import {RbcTab,RbcTabContent} from 'wm'
        createApp({
            
            components: {
                'rbc-tab': RbcTab,
                'rbc-tab-content': RbcTabContent,
            },
            
            
            data() { 
                return {
                    fundData : null,
                };
            },
            computed: {
            hasTopHoldings() {
                return this.fundData?.topHoldings && !this.isEmpty(this.fundData?.topHoldings);
            },

            hasTopUnderlyingHoldings() {
                return this.fundData?.topUnderlyingHoldings && !this.isEmpty(this.fundData?.topUnderlyingHoldings);
            },

            hasTermToMaturity() {
                return this.fundData?.termToMaturity && !this.isEmpty(this.fundData?.termToMaturity);
            },

            hasCreditRating() {
                return this.fundData?.creditRating && !this.isEmpty(this.fundData?.creditRating);
            },

            hasCountryAllocation() {
            return this.fundData?.countryAllocation && !this.isEmpty(this.fundData?.countryAllocation);
            },

            hasEquitySectorAllocation(){
            return this.fundData?.equitySectorAllocation && !this.isEmpty(this.fundData?.equitySectorAllocation);
            }
        },

        methods: {
            isEmpty(value) {
                if (Array.isArray(value)) {
                    return value.length === 0;
                }
                if (typeof value === 'object' && value !== null) {
                    return Object.keys(value).length === 0;
                }
                return !value;
            }
