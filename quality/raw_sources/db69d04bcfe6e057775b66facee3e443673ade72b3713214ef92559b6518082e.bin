                    @searchtermchanged="debounceMegaSearch"
                    @searchsidenavsubmitted="mobileSearch"
                    @keyup="megaSearchKeyUp"
            >
                <template #[primarylevel.id]
                          v-for="primarylevel in nav.links.filter(({children}) => !!children && children.length > 0)">
                    <div class="row">
                        <template v-for="secondaryLevel in primarylevel.children">
                            <template v-if="!!secondaryLevel
                            && secondaryLevel.type === 'folder'
                            && secondaryLevel.id !== 'nav.advisorsupport.themes'">
                                <div :key="secondaryLevel.id" class="col-md-3">
                                    <span class="mega-menu-content-header">
                                        {{secondaryLevel.title}}
                                    </span>
                                                                      <ul class="mega-menu-content-items">
                                        <template v-for="thirdLevel in secondaryLevel.children">
                                            <template v-if="!!thirdLevel
                                            && (thirdLevel.type !== 'folder' || thirdLevel.id !== thirdLevel.title)">
                                                <li :key="thirdLevel.id" class="mega-menu-content-item">
                                                    <a class="mega-menu-content-link"
                                                       :class="{'medium': (thirdLevel.link).replace(secondaryLevel.link, '') === '/index'}"
                                                       :href="thirdLevel.link"
                                                       :title="thirdLevel.title">
                                                        {{thirdLevel.title}}
                                                    </a>
                                                </li>
                                            </template>
                                        </template>
                                    </ul>
                                </div>
                            </template>
                            <template v-else-if="(secondaryLevel.link).replace(primarylevel.link,'') !== '/index'">
                                <div v-if="secondaryLevel.id === 'nav.advisorsupport.themes'"
                                     :key="secondaryLevel.id" class="col-md-9">
                                    <span class="mega-menu-content-header">{{secondaryLevel.title}}</span>
                                    <ul class="mega-menu-content-items mb-1" aria-hidden="true"></ul>
                                    <div class="row">
                                        <template v-for="(featuredTheme, index) in featuredThemesObj.links">
