<script type="module">
    import {createApp} from 'vue'
    import {RbcExpandable, RbcExpandableContainer, RbcCard, RbcButton} from 'wm'

    createApp({
        data() {
            return {
                isMd: false,
                getCurrentUrl: window.location.href
            };
        },
        components: {
            'rbc-button': RbcButton,
            'rbc-expandable': RbcExpandable,
            'rbc-card': RbcCard,
            'rbc-expandable-container': RbcExpandableContainer
        },
        methods: {
            checkIsMd() {
                this.isMd = window.innerWidth >= 768;
            }
        },
        mounted() {
            this.checkIsMd();
            window.addEventListener('resize', this.checkIsMd);
        },
        beforeUnmount() {
            window.removeEventListener('resize', this.checkIsMd);
        }
    }).mount(`#app_id_4112067`);
</script>

    
