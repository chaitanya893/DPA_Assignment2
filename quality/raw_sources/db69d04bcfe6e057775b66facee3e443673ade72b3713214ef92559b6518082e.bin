            return {
                currentYear: new Date().getFullYear(),
                growth10kInitValFDS: 10000,
                growth10kDataLengthFDS: 0,
                growth10kDatesFDS: '',
                growth10kAsOfFDS: '',
                ticker:'',
                growth10kChartDataFDS: [],
                containYearBefore: '', 
                chartGrowth10kFDS : '',
                restirctedFundForshowing: false,
            };
        },
        methods: {
        convertDate (date)
        {
        return new Date(date).toLocaleString("en-us", {
			year: 'numeric',
			month: 'numeric',
			day: 'numeric',
			timeZone: 'UTC'
		});
        },
            fundFormatDataGrowth10kFDS(data, rbcFundCode) {
                if (data.growth10k && Object.keys(data.growth10k).length > 0) {
                    this.growth10kcreateChartFDS(data.growth10k, rbcFundCode);
                }
            },
            
            growth10kCreateButtonFDS(number, type, text) {
                var unit = (type === 'year') ? 'y' : 'm';
                return { type, count: number, text };
            },
            
            growth10kUpdateChartFDS (array, maxVal,month) {
                this._chart.series[0].setData(array);
            },
            
            dateFormating10k (dateString) {
                let parts = dateString.split('-');
                let reformattedDate = `${parts[1]}/${parts[2]}/${parts[0]}`;
                return reformattedDate;
            },
            
            growth10kcreateChartFDS(data, rbcFundCode) {
             var _self = this;
             var g10k = data;
	         var newVal = this.growth10kInitValFDS;

             this.growth10kChartDataFDS = this.growth10kDatesFDS.map(function(key) {
              let parts = key.split('-'); 
              let year = parts[0];
              let month = parseInt(parts[1], 10); 
              let day = parseInt(parts[2], 10);
              let formattedDate = new Date(year, month - 1, day).getTime();
              let newVal = g10k[key].val;
              
              return [formattedDate, newVal];
            });

            const dateFormat = '%b %e, %Y';

            const formatterFunction = function(point) {
                return point.series.name + ': <span class="strong" style="fill: currentColor">' + formatCurrency(point.y, 'en', 2) + '</span>';
            };

    	    if(typeof this.$refs.chartGrowth10kFDS != "undefined") {
    		    this._chart = Highcharts.stockChart(this.$refs.chartGrowth10kFDS, {
                    exporting: {
                        enabled: false
                    },
                    accessibility: {
                        description: `This chart shows calendar returns for the fund ${rbcFundCode}`,
                        keyboardNavigation: {
                            order: ["container", "series", "zoom", "rangeSelector"]
                        },
                        point: {
                            descriptionFormatter: function(point) {
                                return formatterFunction(point);
                            }
                        }
                    },
    			    rangeSelector: {
    				    selected: 6,
    				    buttons: this.chartButtonsFDS,
    				    buttonTheme: {
    					    padding: 5,
    					    width: null,
    					    height: 14
    				    },
    				    buttonSpacing: 5,
    				    inputEnabled: false
    			    },
    			    scrollbar: {
    				    liveRedraw: false,
    				    enabled: false
    			    },
    			    tooltip: {
    				    split: false
    			    },
    			    xAxis: {
    				    events: {
    					    afterSetExtremes: function(e) {
    						var findMin, findMax = false;
    						var min, max = 0;
    						var updatedArray = [];
    						var maxVal = 0;
    						var variation = 0;
    						for (var i = 0; i < _self.growth10kDataLengthFDS; i++) {
    							variation = g10k[_self.growth10kDatesFDS[i]].var;
    							newVal = findMin ? newVal + newVal * (variation / 100) : _self.growth10kInitValFDS;
    							updatedArray[i] = [_self.growth10kChartDataFDS[i][0], newVal];
    							if (!findMin && (_self.growth10kChartDataFDS[i][0] > (e.min - 1))) { 
    								findMin = true;
    								min = i;
    							}
    							if (!findMax && findMin && _self.growth10kChartDataFDS[i][0] <= (e.max)) {
    								maxVal = newVal;
    								max = i
    							}
    							if (!findMax && _self.growth10kChartDataFDS[i][0] > (e.max)) {
    								findMax = true;
    								max = i;
    							}
    						}
    						_self.growth10kUpdateChartFDS(updatedArray, maxVal, (max-min)+1);
    					    }
    				    },
    				    crosshair: {
    					    width: 1,
    					    color: '#003168'
    				    },
    				    minRange: 2629800000
    			    },
    			    series: [{
    				    name: 'Series DZ',
    				    data: this.growth10kChartDataFDS,
    				    type: 'area',
    				    fillColor: 'rgba(227, 244, 255, 0.65)',
    				    tooltip: {
    					    pointFormatter: function() {
    						    return formatterFunction(this);
    					    },
    					    xDateFormat: dateFormat
    				    }
    			    }],
    		    });

                const label = 'Growth of $10,000';
                const rootElem = document.getElementById("growth10kFDS");
                rootElem.setAttribute("aria-label", label + ' - Interactive Chart Root');
                rootElem.querySelector(".highcharts-container").setAttribute("aria-label", label + ' - Interactive Chart Container');
                rootElem.querySelector("svg").setAttribute("aria-label", label + ' - Interactive Chart');
                rootElem.querySelector(".highcharts-container").setAttribute("role", 'region');
                rootElem.querySelector(".highcharts-exit-anchor").setAttribute("role", "region");
                rootElem.querySelector(".highcharts-exit-anchor").setAttribute("aria-label", label + ' - Interactive Chart End');
	    }
        }
        },
        computed: {
            chartButtonsFDS() {
                let array = [{ type: 'ytd', text: 'YTD', offsetMin: -386400000 }];
                
                if (this.growth10kDataLengthFDS > 6) {
                    array.push(this.growth10kCreateButtonFDS(6, 'month', '6m'));
                }
                if (this.growth10kDataLengthFDS > 12) {
                    array.push(this.growth10kCreateButtonFDS(366, 'day', '1y'));
                }
                if (this.growth10kDataLengthFDS > 36) {
                    array.push(this.growth10kCreateButtonFDS(1096, 'day', '3y'));
                }
                if (this.growth10kDataLengthFDS > 60) {
                    array.push(this.growth10kCreateButtonFDS(1827, 'day', '5y'));
                }
                if (this.growth10kDataLengthFDS > 120) {
                    array.push(this.growth10kCreateButtonFDS(3654, 'day', '10y'));
                }
                array.push({ type: 'all', text: 'All' });
                
                return array;
            },
        },
        
