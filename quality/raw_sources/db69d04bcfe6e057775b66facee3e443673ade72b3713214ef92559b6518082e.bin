0.141190881038,"FirstService Corp":0.166690493453,"Brookfield Asset Management Ltd - Class A Shares":0.477249244778,"BlackBerry Ltd":0.19277805758799998,"Manulife Financial Corp":1.9113663161649999,"Silvercorp Metals Inc":0.063454420389,"Methanex Corp":0.08647157567000001,"Cargojet Inc":0.024706076953999997,"Metro Inc/CN":0.345513596162,"Ivanhoe Mines Ltd":0.167947118699,"Tamarack Valley Energy Ltd":0.11909806734400001,"Canadian Natural Resources Ltd":2.357262957204,"Aecon Group Inc":0.062494905852,"Triple Flag Precious Metals Corp":0.058979348944000004,"Definity Financial Corp":0.142451910955,"Discovery Silver Corp":0.106846523627,"IGM Financial Inc":0.12691091773,"Fairfax Financial Holdings Ltd":0.923460934322,"Lundin Mining Corp":0.46500461980499996,"Linamar Corp":0.07784500003,"Brookfield Renewable Partners LP - Partnership Shares":0.22407698168,"Thomson Reuters Corp":0.30277595084200004,"Chartwell Retirement Residences - Units":0.144419213407,"Pan American Silver Corp":0.5333528788749999,"Altius Minerals Corp":0.056553482827000005,"Open Text Corp":0.151630460939,"Constellation Software Inc/Canada":1.059763184792,"Aritzia Inc":0.299907334703,"Exchange Income Corp":0.140409285588,"TerraVest Industries Inc":0.034285174139,"Lithium Americas Corp":0.032784157046,"G Mining Ventures Corp":0.139575492482,"Killam Apartment Real Estate Investment Trust":0.045653170855,"Northland Power Inc":0.11602509770399999,"Canadian Tire Corp Ltd - Class A Shares":0.191839192586,"First Quantum Minerals Ltd":0.521212210616,"Banque Nationale du Canada":1.728924454106,"Seabridge Gold Inc":0.064379997132,"Bausch Health Cos Inc":0.035931429808,"Power Corp of Canada":0.940137445498,"NGEx Minerals Ltd":0.068352213341,"Richelieu Hardware Ltd":0.040696861871,"RioCan Real Estate Investment Trust":0.131691663865,"Alimentation Couche-Tard Inc":1.3391288244239998,"Choice Properties Real Estate Investment Trust":0.088213915897,"Spartan Delta Corp":0.040769594005},"topHoldings_fr":{"Banque Royale du Canada":7.5971045705160005,"Banque Toronto-Dominion":5.374632754063001,"Shopify Inc":4.779585623061,"Banque de Montréal":3.1763222830110003,"Banque de Nouvelle-Écosse":2.990662695402,"Enbridge Inc":2.98151882865,"Canadian Natural Resources Ltd":2.780382734929,"Banque Canada Impériale de Commerce":2.777186113185,"Agnico Eagle Mines Ltd":2.743504419204,"Brookfield Corp":2.339276043169,"Canadian Pacific Kansas City Ltd":2.186716714692,"Suncor Energy Inc":2.10065976149,"Barrick Mining Corp":2.0054862862559997,"Manulife Financial Corp":1.897135949402,"Wheaton Precious Metals Corp":1.8216606181410002,"Canadian National Railway Co":1.795963334387,"TC Energy Corp":1.7337934046730001,"Banque Nationale du Canada":1.5723812320989998,"Franco-Nevada Corp":1.3486489391590002,"Constellation Software Inc/Canada":1.199285738943,"Alimentation Couche-Tard Inc":1.190929851806,"Sun Life Financial Inc":1.166563233708,"Cenovus Energy Inc":1.152896310625,"Cameco Corp":1.143009684227,"Waste Connections Inc":1.12205843994},"topUnderlyingHoldings":{},"topUnderlyingHoldingsQuarterly":{},"topUnderlyingHoldingsQuarterlyPrevious":{},"topUnderlyingHoldingsQuarterlyPrevious_fr":{},"topUnderlyingHoldingsQuarterly_fr":{},"totalFundAssets":2.080545191E9,"trailingReturn":{"6Mth":6.410101,"sinceInception":9.080796,"3Mth":4.679698999999999,"1Mth":3.027548,"YTD":15.420225000000002,"1Yr":28.919223,"15Yr":9.642939,"3Yr":23.845739,"5Yr":14.459996,"10Yr":11.989288}};
            const rbcFundCode = fundData.rbcFundCode;
            this.assetMixData = fundData.assetMix;
            this.isEquityLongShortFund = EQUITY_LONG_SHORT_FUNDS.includes(rbcFundCode);
            this.hideEquityVsFixedSection = HIDE_EQUITY_VS_FIXED_MF_FUNDS.includes(rbcFundCode);

            if (this.isEquityLongShortFund) {
                this.longShortAssetMixData = fundData.longShortAssetMix || null;
                if (this.longShortAssetMixData && fundData.analysisDate && fundData.analysisDate.longShortAssetMix) {
                    this.assetMixAsOf = this.convertDate(fundData.analysisDate.longShortAssetMix);
                }
            }
            if (fundData && Object.keys(fundData).length) {
                if (fundData.assetMix && Object.keys(fundData.assetMix).length > 0) {
                    this.assetMixAsOf = this.convertDate(fundData.analysisDate.assetMix) ;
                    this.assetMixCreateChart(fundData.assetMix, rbcFundCode)
                }
            }

            if (fundData && Object.keys(fundData).length) {
                if (!this.hideEquityVsFixedSection && (fundData.equityRatio || fundData.fixedIncomeRatio)) {
                    this.equityVsFixedFormatData({
                        "equityRatio": fundData.equityRatio,
                        "fixedIncomeRatio": fundData.fixedIncomeRatio,
                        rbcFundCode: rbcFundCode
                    });
                }
            }
            this.$nextTick(() => {
                const progressBarComponent = this.$refs.progressBar;
                if (progressBarComponent && progressBarComponent.$el) {
                    const progressBar = progressBarComponent.$el.querySelector('.rbc-progressbar-bar');
                    if (progressBar) {
                        progressBar.classList.remove('rbc-progressbar-bar');
                        progressBar.classList.add('progressbar-bar');
                    }
                }
            });

        },
    }).mount('#app_id_5327932')
</script>

    
<div id="app_id_5604039" v-cloak>
    <Teleport to="#sector-allocation-mf-slot">
        <article
                class="pt-0 section-block section-block-sm"
                data-location="fund sector allocation"
                v-if='!isEquityLongShortFund'>
            <div class="row">
                                    <div v-if="sectorAllocationEquityData.length > 0" class="col-lg section-block-spacer-sm">
                        <h3>
                            Equity sector allocation
                        </h3>
                        <div
                                v-for="item in sectorAllocationEquityData"
                                class="progressbar-icon"
                        >
                            <div class="progressbar-text">
						<span class="progressbar-text-col progressbar-text-icon">
							<rbc-icon class="icon" :icon="item.icon"></rbc-icon>
							{{ item.key }}
						</span>
                                <span class="progressbar-text-col">
							{{ item.value }}
						</span>
                            </div>
                            <rbc-progressbar size="small" :aria-label="item.key" :progress="item.percent"></rbc-progressbar>
                        </div>
                    </div>
                
                <div v-if="sectorAllocationFixedData.length > 0" class="col-lg">
                    <h3>
                        Fixed income breakdown
                    </h3>
                    <div
                            v-for="item in sectorAllocationFixedData"
                            class="progressbar-icon"
                    >
                        <div class="progressbar-text">
						<span class="progressbar-text-col progressbar-text-icon">
							<rbc-icon class="icon" :icon="item.icon"></rbc-icon>
							{{ item.key }}
						</span>
                            <span class="progressbar-text-col">
							{{ item.value }}
						</span>
                        </div>
                        <rbc-progressbar size="small" :aria-label="item.key" :progress="item.percent"></rbc-progressbar>
                    </div>
                </div>
            </div>
        </article>

        <div data-test="equity-long-short-sector-allocation-section" v-if="isEquityLongShortFund && longShortSectorData">
            <article class="section-block section-block-sm" data-location="fund equity long short sector allocation">
                <header class="row section-block-header">
                    <h3 class="col-sm">Equity sector allocation</h3>
                    <span class="col-sm text-sm-right footnote">As of {{ longShortAsOf }}</span>
                </header>
                <div class="table-responsive">
                    <table class="text-right table table-compact table-border-horizontal table-transparent table-striped ls-sector-table" style="min-width: 490px;">
                        <thead>
                        <tr>
                            <th aria-hidden="true"></th>
                            <th class="text-right">Long weight %</th>
                            <th class="text-right">Short weight %</th>
                            <th class="text-right">Net weight %</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr v-for="row in longShortSectorTableRows" :key="row.key">
                            <th class="nowrap text-left">{{ row.display }}</th>
                            <td class="nowrap">{{ formatLongShortWeight(row.longWeight) }}</td>
                            <td class="nowrap">{{ formatLongShortWeight(row.shortWeight, true) }}</td>
                            <td class="nowrap">{{ formatLongShortWeight(row.netWeight) }}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </article>
        </div>
    </Teleport>
</div>

<script type="module">
    import {formatCurrency} from "utils";
    import {createApp} from 'vue'
    import {RbcIcon, RbcProgressbar} from 'wm'

    const EQUITY_LONG_SHORT_FUNDS = ['RBF941', 'RBF441', 'RBF8257', 'RBF8258', 'RBF9941', 'RBF9441', 'RBF1441', 'RBF2941', 'RBF8358'];

    const SECTOR_TEXT_MAP = {
        'Materials':                   "Materials",
        'Consumer Staples':            "Consumer staples",
        'Financials':                  "Financials",
        'Financial':                   "Financial",
        'Real Estate':                 "Real estate",
        'Consumer Discretionary':      "Consumer discretionary",
        'Health Care':                 "Health care",
        'Utilities':                   "Utilities",
        'Communication Services':      "Communication services",
        'Telecommunications Services': "Telecommunications services",
        'Energy':                      "Energy",
        'Industrials':                 "Industrials",
        'Industrial':                  "Industrial",
        'Information Technology':      "Information technology",
        'Corporate':                   "Corporate",
        'Cash':                        "Cash",
        'Unclassified':                "Unclassified",
        'Government':                  "Government",
        'Securitized':                 "Securitized",
        'Federal':                     "Federal",
        'Communication':               "Communication",
        'Provincial':                  "Provincial",
        'Infrastructure':              "Infrastructure",
        'Other':                       "Other",
        'abs':                         "Direct mortgages",
        'mbs':                         "Securitized debt",
        'commercialpaper':             "Commercial paper",
        'bankersacceptance':           "Bankers acceptance",
        'bankdeposits':                "Bank deposits",
        'provincialbills':             "Provincial bills",
        'treasurybills':               "Treasury bills"
    };

    createApp({
        components: {
            'rbc-progressbar': RbcProgressbar,
            'rbc-icon': RbcIcon
        },

        data() {
            return {
                sectorAllocationEquityData: [],
                sectorAllocationFixedData: [],
                isEquityLongShortFund: false,
                longShortSectorData: null,
                longShortAsOf: ''
            };
        },

        computed: {
            longShortSectorTableRows() {
                if (!this.longShortSectorData) return [];
                const data = this.longShortSectorData;
                const isNonZeroAfterRounding = (v) => typeof v === 'number' && parseFloat(v.toFixed(1)) !== 0;
                return Object.keys(data)
                    .filter(key => {
                        // Unclassified shown only if any weight is non-zero after rounding
                        if (key === 'Unclassified') {
                            const row = data[key];
                            return isNonZeroAfterRounding(row.longWeight) || isNonZeroAfterRounding(row.shortWeight) || isNonZeroAfterRounding(row.netWeight);
                        }
                        return true;
                    })
                    .map(key => ({
                        key,
                        display: SECTOR_TEXT_MAP[key] || key,
                        longWeight:  data[key].longWeight  ?? null,
                        shortWeight: data[key].shortWeight ?? null,
                        netWeight:   data[key].netWeight   ?? null
                    }))
                    // sort by net weight descending
                    .sort((a, b) => (b.netWeight ?? 0) - (a.netWeight ?? 0));
            }
        },

        methods: {
            convertDate(date) {
                return new Date(date).toLocaleString("en-us", {
                    year: 'numeric',
                    month: 'numeric',
                    day: 'numeric',
                    timeZone: 'UTC'
                });
            },
            sectorAllocationFormatData(data) {
                if (data.bondSectorAllocationRBC && Object.keys(data.bondSectorAllocationRBC).length > 0) {
                    this.sectorAllocationFixedData = this.sectorAllocationCreateBars(data.bondSectorAllocationRBC, true)
                }
                if (data.equitySectorAllocation && Object.keys(data.equitySectorAllocation).length > 0) {
                    this.sectorAllocationEquityData = this.sectorAllocationCreateBars(data.equitySectorAllocation, true)

                }
            },
            sectorAllocationCreateBars(data, isOrdered) {
                const iconMap = {
                    'Materials': 'cube',
                    'Consumer Staples': 'shopping-cart',
                    'Financials': 'usd-circle',
                    'Financial': 'usd-circle',
                    'Real Estate': 'home',
                    'Consumer Discretionary': 'user',
                    'Health Care': 'heart',
                    'Utilities': 'lightbulb',
                    'Communication Services': 'mobile-android-alt',
                    'Telecommunications Services': 'satellite-dish',
                    'Energy': 'fire',
                    'Industrials': 'industry-alt',
                    'Industrial': 'industry',
                    'Information Technology': 'desktop',
                    'Corporate': 'pen-nib',
                    'Cash': 'database',
                    'Other': 'question-circle',
                    'Unclassified': 'question-circle',
                    'Government': 'building',
                    'Securitized': 'shield-check',
                    'Federal': 'landmark-alt',
                    'Communication': 'comment-lines',
                    'Provincial': 'landmark',
                    'Infrastructure': 'ball-pile',
                    'abs': 'shield',
                    'mbs': 'shield-alt',
                    'commercialpaper': 'file-contract',
                    'bankersacceptance': 'user-tie',
                    'bankdeposits': 'envelope-open-dollar',
                    'provincialbills': 'money-check-alt',
                    'treasurybills': 'scroll'
                }
                const textMap = SECTOR_TEXT_MAP;
                const textOrder = [
                    'Government',
                    'Corporate',
                    'Other',
                    'mbs',
                    'Cash',
                    'abs'
                ]
                const sortedSet = new Set();

                if (isOrdered) {
                    textOrder.forEach(key => {
                        if (data[key] != null) {
                            sortedSet.add(key);
                        }
                    });
                }

                const unorderedKeys = Object.keys(data).filter(key => !sortedSet.has(key));

                unorderedKeys.sort((a, b) => data[b] - data[a]);

                const sortedKeys = isOrdered ? [...sortedSet, ...unorderedKeys] : unorderedKeys;

                const result = sortedKeys.map(key => {
                    let value = formatCurrency(data[key], 'en', 1, '%');
                    if (value === "-0.0%") {
                        value = "0.0%";
                    }
                    return {
                        key: textMap[key] || key,
                        value: value,
                        percent: data[key],
                        icon: iconMap[key] || ''
                    };
                });
                return result;
            },

            formatLongShortWeight(value, isShort) {
                if (value === null || value === undefined) {
                                            return '0.0';
                                    }
                const formatted = formatCurrency(value, 'en', 1, '');
                if (isShort && (formatted === '-0,0' || formatted === '-0.0')) {
                    return formatted.slice(1);
                }
                return formatted;
            }

