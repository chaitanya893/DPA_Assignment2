<script type="module">
    import {
        getThemeData
    } from "vite-esm/add-to-theme.service.js";
    import {createApp} from "vue"
    import {
        RbcMegaMenu, RbcIcon, RbcCard, RbcMediaCard, RbcTag, RbcButton
    } from "wm"
    import {
        debounce
    } from "wm-utils"

    const dataLayer = [];
