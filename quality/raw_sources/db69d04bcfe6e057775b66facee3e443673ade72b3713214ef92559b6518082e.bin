<div id="app_id_7633332" v-cloak>
        <Teleport to="#trailing-return-mf-slot">
   <div data-test="training-return-section">
        <article class="section-block section-block-sm" data-test="trailing-returns-section">
            <header class="row section-block-header" data-location="fund trailing return"
                    data-test="trailing-returns-header">
                <h3 class="col-sm" data-test="trailing-returns-title">
                    Trailing returns %
                </h3>
                <div class="col-sm text-sm-right footnote mb-half mb-sm-0" data-test="trailing-returns-asof">
                    <span class="d-block">As of  {{ trailingReturnsAsOf }}</span>
                </div>
            </header>
            <div class="table-responsive" data-test="trailing-returns-table-container">
                <table class="text-right table table-compact table-striped table-border-horizontal table-transparent"
                       data-test="trailing-returns-table">
                    <thead>
                    <tr data-test="trailing-returns-header-row">
                        <th aria-hidden="true"></th>
                        <th v-if="showYTD" data-test="ytd-header" class="text-right">YTD</th>
                        <th class="text-right" data-test="1mth-header">1 mo</th>
                        <th class="text-right" data-test="3mth-header">3 mo</th>
                        <th class="text-right" data-test="6mth-header">6 mo</th>
                        <th class="text-right" data-test="1year-header">1 yr</th>
                        <th class="text-right" data-test="3year-header">3 yr</th>
                        <th class="text-right" data-test="5year-header">5 yr</th>
                        <th class="text-right" data-test="10year-header">10 yr</th>
                        <th class="text-right" data-test="incept-header">Incept.</th>
                    </tr>
                    </thead>
                    <tbody v-if="Object.keys(trailingReturnsData)" data-test="trailing-returns-data">
                    <tr data-test="fund-row">
                        <th scope="row" class="text-left" >
                            Fund
                        </th>
                        <td
                                v-for="(val, key) in trailingReturnsData"
                                :key="'fund' + key"
                                :data-location="'fund-value-' + key"
                        >
                                                            {{ displayNumber(trailingReturnsData[key].fund,1) }}
                                                    </td>
                    </tr>
                    <tr data-test="quartile-row" v-if='isVirtualClassFund'>
                                            <th scope="row" class="text-left" data-test="quartile-label">
                            Quartile
                        </th>
                        <td
                                v-for="(val, key) in trailingReturnsData"
                                :key="'quartile' + key"
                                v-html="(trailingReturnsData[key].fund != null) ? trailingReturnsData[key].quartile : '-'"
                                :data-test="'quartile-value-' + key"
                        >
                        </td>
                    </tr>
                        <tr data-test="no-funds-row" v-if='isVirtualClassFund'>
                                            <th scope="row" class="text-left" data-test="no-funds-label">
                            No. funds in category
                        </th>
                        <td
                                v-for="(val, key) in trailingReturnsData"
                                :key="'nbFunds' + key"
                                v-text="(trailingReturnsData[key].fund != null) ? trailingReturnsData[key].nbFunds : '-'"
                                :data-test="'no-funds-value-' + key"
                        >
                        </td>
                    </tr>
                    </tbody>

                </table>
            </div>
        </article>
    </div>
</Teleport>
</div>




<script type="module">
    import {createApp} from 'vue'

    createApp({
        components: {},
        data() {
            return {
                head: 'trailing returns',
                trailingReturnsAsOf: '',
                trailingReturnsAsOfDate: new Date(),
                trailingReturnsData: {},
                isVirtualClassFund: null,
                showYTD: false
            }
        },
        methods: {
            trailingReturnsFormatData(data) {
                var _self = this;
                const date = this.trailingReturnsAsOfDate;
                const isDec31 = date.getMonth() === 11 && date.getDate() === 31;
                const keys = [
                    '1Mth',
                    '3Mth',
                    '6Mth',
                    '1Yr',
                    '3Yr',
                    '5Yr',
                    '10Yr',
                    'sinceInception'
                ];
                if (!isDec31) {
                    keys.unshift('YTD');
                    this.showYTD = true;
                }
                keys.forEach((key) => {
                    _self.trailingReturnsData[key] = {
                        fund: data.trailingReturn && data.trailingReturn[key] ? data.trailingReturn[key] : 0,
                        quartile: data.performanceRanking && data.performanceRanking[key] ? _self.formatQuartile(data.performanceRanking[key]) : '-',
                        nbFunds: data.nbFundsPerCategory && data.nbFundsPerCategory[key] && data.performanceRanking && data.performanceRanking[key] ? data.nbFundsPerCategory[key] : '-'
                    };
                });
            },

            displayNumber(n, toFixed, withUnit) {
                var localToFixed = (typeof toFixed == 'undefined') ? 1 : toFixed;
                                    return n ? ((n * 100) / 100).toFixed(localToFixed) : '-';
                            },

            formatQuartile(val) {
                var isFr = 'en' === 'fr';
                var isChinese = ('en' === 'zh' || 'en' === 'zh-hant');

                if (isFr) {
                    var numberMap = {
                        1: '<sup>er</sup>'
                    }
                } else if (isChinese) {
                    var numberMap = {}
                } else {
                    var numberMap = {
                        1: 'st',
                        2: 'nd',
                        3: 'rd'
                    }
                }

                if (numberMap[val]) {
                    return val + numberMap[val];
                } else {
                    return val ? val + (isFr ? '<sup>e</sup>' : isChinese ? '' : 'th') : null;
                }
            },
        convertDate (date) {
           return new Date(date).toLocaleString("en-us", {
			year: 'numeric',
			month: 'numeric',
			day: 'numeric',
			timeZone: 'UTC'
		});
        }
