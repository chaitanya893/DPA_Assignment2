        methods: {
            updateActiveMenuItem() {
                if (currRelPath.includes("/products/")) {
                    this.activeMenuItem = 0;
                } else if (currRelPath.includes("/insights/") || currRelPath.includes("/article/")) {
                    this.activeMenuItem = 1;
                } else if (currRelPath.includes("/learn-plan/")) {
                    this.activeMenuItem = 2;
                } else if (currRelPath.includes("/about-us/") || currRelPath.includes("/team/") || currRelPath.includes("/profile/")) {
                    this.activeMenuItem = 3;
                } else if (currRelPath.includes("/tools/")) {
                    this.activeMenuItem = 4;
                } else if (currRelPath.includes("/advisor-support/") || currRelPath.includes("/theme/") || currRelPath.includes("/rbc-theme/")) {
                    this.activeMenuItem = 5;
                } else {
                    this.activeMenuItem = null;
                }
            },
            megaSearch(searchTerm) {
                this.searchResultsActive = -1;
                if (searchTerm != "") {
                    this.searchTerm = searchTerm;
                    fetch(`${langPrefix}/ca/megamenu-search?search=${searchTerm}`)
                            .then((resp) => resp.json())
                            .then((data) => {
                                this.searchResults = data.data;
                            })
                            .catch((err) => {
                                this.searchResults = [];
                            })
                } else {
                    this.searchResults = [];
                    this.searchTerm = "";
                }
            },
            debounceMegaSearch: debounce(function (searchTerm) {
                if (this.searchTerm !== searchTerm) {
                    this.megaSearch(searchTerm);
                }
            }, 500),
            toggleLanguage(nextlanguage) {
                const currRelPathArr = currRelPath.split("/");
                currRelPathArr[1] = nextlanguage.languageCode;
                const newRelPath = currRelPathArr.join("/");
                const removeKeysFromSearch = (keysToRemove) => {
                    const queryParams = new URLSearchParams(location.search);
                    keysToRemove.forEach(key => queryParams.delete(key));
                    const retString = queryParams.toString();
                    return retString ? "?" + retString : "";
                };
                const newQueryString = removeKeysFromSearch(["dotcache", "language_id", "dotcms_persona", "com.dotmarketing.htmlpage.language"]);
                location.href = newRelPath + newQueryString;
            },
            mobileSearch(searchTerm) {
                if (!!searchTerm) {
                    location.href = `${langPrefix}/ca/search-results/?q=${searchTerm}`;
                }
            },
            addSearchToDataLayer(searchVal) {
                if (searchVal.target.value.trim() !== "") {
                    dataLayer.push({
                        event: "view_search_results",
                        search_results_num: this.searchResults.length,
                        method: 'generic search',
                        search_term: this.searchTerm,
                    })
                }
            },
            navigateToDetailPage(pickedItem) {
                dataLayer.push({
                    'event': 'rbcwmPageview',
                    'virtualpath': `${langPrefix}/ca/virtual/search-results-megasearch/?q=${this.searchTerm}`,
                    'virtualtitle': 'Virtual Search Results',
                    'data-searchterm': this.searchTerm,
                    'data-totalresults': this.searchResults.length
                });
                if (pickedItem.type === "mf") {
                    location.href = `${langPrefix}/ca/products/mutual-funds/${pickedItem.fundCode}/detail/`;
                } else {
                    location.href = `${langPrefix}/ca/products/etfs/${pickedItem.fundCode}/detail/`
                }
            },
            megaSearchKeyUp: debounce(function (searchVal) {
                this.addSearchToDataLayer(searchVal);
                const key = searchVal.key.toLowerCase();
                if (key.indexOf('enter') > -1 && this.searchResultsActive === -1) {
                    let encodedQuery = encodeURIComponent(this.searchTerm);
                    location.href = `${langPrefix}/ca/search-results/?q=${encodedQuery}`;
                } else if (key.indexOf('enter') > -1 && this.searchResultsActive > -1) {
                    let pickedItem = this.searchResults[this.searchResultsActive];
                    this.navigateToDetailPage(pickedItem);
                } else if (key.indexOf('down') > -1 && this.searchResultsActive < (this.searchResults.length - 1)) {
                    this.searchResultsActive++;
                } else if (key.indexOf('up') > -1 && this.searchResultsActive > -1) {
                    this.searchResultsActive--;
                }
            }, 300),
            addToTheme: (id) => {
                const queryParams = {
                    lang: 1,
                    identifier: id,
                    advisorID: "",
                    userPersonaTag: "individualinvestor",
                }
                getThemeData(queryParams);
            },
            megaSearchResultClick(r, e) {
                this.navigateToDetailPage(r);
            }
        },
        mounted() {
            this.updateActiveMenuItem();
            let _self = this;
            document.addEventListener("keyup", function (e) {                if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() == 'f') {
                    _self.$refs.megamenu.$_MegaMenu_showSearch();
                }
            });
        },
        unmount() {
        }
    }).mount('#app_id_2483711')
</script>
