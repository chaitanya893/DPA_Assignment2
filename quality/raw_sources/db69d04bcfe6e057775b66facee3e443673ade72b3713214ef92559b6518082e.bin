<div id="app_id_1368107" v-cloak>
        <Teleport to="#balancedMFequilty-characteristics-mf-slot" >
            <article class="section-block section-block-sm" data-location="fund equity style">
		<header class="row section-block-header">
            <h4 class="col-sm">Equity characteristics</h4>			<span class="col-sm text-sm-right footnote">As of {{ equityStyleAsOf }}</span>
		</header>

		<div class="row align-items-center">
			<div 
				v-if="equityStyleActive"
				class="col-sm-6 text-center text-sm-left section-block-spacer-sm"
			>
				<div 
					class="d-inline-block"
					style="width: 250px"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 250 205">
						<rect 
							id="valueLarge" 
							:class="{'c-primary': equityStyleActive === 'Value-Large' || equityStyleActive === 'Large Value'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							width="56" height="56"
						/>
						<rect 
							id="valueMed" 
							:class="{'c-primary': equityStyleActive === 'Value-Medium' || equityStyleActive === 'Value-Mid' || equityStyleActive === 'Medium Value' || equityStyleActive === 'Mid Value'}"
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							y="58" width="56" height="56"
						/>
						<rect 
							id="valueSmall" 
							:class="{'c-primary': equityStyleActive === 'Value-Small' || equityStyleActive === 'Small Value'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							y="116" width="56" height="56"
						/>
						<rect 
							id="blendLarge" 
							:class="{'c-primary': equityStyleActive === 'Blend-Large' || equityStyleActive === 'Large Blend'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="58" width="56" height="56"
						/>
						<rect 
							id="blendMed" 
							:class="{'c-primary': equityStyleActive === 'Blend-Medium' || equityStyleActive === 'Blend-Mid' || equityStyleActive === 'Medium Blend' || equityStyleActive === 'Mid Blend'}"
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="58" y="58" width="56" height="56"
						/>
						<rect 
							id="blendSmall" 
							:class="{'c-primary': equityStyleActive === 'Blend-Small' || equityStyleActive === 'Small Blend'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="58" y="116" width="56" height="56"
						/>
						<rect 
							id="growthLarge" 
							:class="{'c-primary': equityStyleActive === 'Growth-Large' || equityStyleActive === 'Large Growth'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="116" width="56" height="56"
						/>
						<rect 
							id="growthMed" 
							:class="{'c-primary': equityStyleActive === 'Growth-Medium' || equityStyleActive === 'Growth-Mid' || equityStyleActive === 'Medium Growth' || equityStyleActive === 'Mid Growth'}"
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="116" y="58" width="56" height="56"
						/>
						<rect 
							id="growthSmall" 
							:class="{'c-primary': equityStyleActive === 'Growth-Small' || equityStyleActive === 'Small Growth'}" 
							class="c-grey-light-tint-3" 
							style="fill: currentColor" 
							x="116" y="116" width="56" height="56"
						/>
						<text class="disclaimer c-grey" style="fill: currentColor" transform="translate(190 31)">
							Large
						</text>
						<text class="disclaimer c-grey" style="fill: currentColor" transform="translate(190 89)">
							Mid
						</text>
						<text class="disclaimer c-grey" style="fill: currentColor" transform="translate(190 147)">
							Small
						</text>
						<text class="disclaimer c-grey" style="fill: currentColor; text-anchor: middle" transform="translate(27.5 201.5)">
							Value
						</text>
						<text class="disclaimer c-grey" style="fill: currentColor; text-anchor: middle" transform="translate(85.5 201.5)">
							Blend
						</text>
						<text class="disclaimer c-grey" style="fill: currentColor; text-anchor: middle" transform="translate(143.5 201.5)">
							Growth
						</text>
					</svg>
				</div>
			</div>
			<div class="col-sm-6">
				<span v-if="equityStyleDividendYield || equityStylePBRatio || equityStylePERatio || equityStyleAvgMktCap" class="subheader d-block">
					Statistics
				</span>
				<table class="table table-borderless table-flush-x">
					<tbody>

                        					    <tr v-if="equityStyleDividendYield">
							<th>
								Dividend yield (%)
							</th>
							<td class="text-right">
								{{ equityStyleDividendYield }}
							</td>
						</tr>
                        						<tr v-if="equityStylePBRatio">
							<th>
								P/B ratio
							</th>
							<td class="text-right">
								{{ equityStylePBRatio }}
							</td>
						</tr>

						<tr v-if="equityStylePERatio">
							<th>
								P/E ratio
							</th>
							<td class="text-right">
								{{ equityStylePERatio }}
							</td>
						</tr>
						<tr v-if="equityStyleAvgMktCap">
							<th>
								Avg. mkt cap. $bil
							</th>
							<td class="text-right">
								{{ equityStyleAvgMktCap }}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
						</article>
</Teleport>
</div>


