                        <th aria-hidden="true"></th>
                        <th v-for="item in distributionsDate" data-test="distribution-table-header-dates"
                            class="text-right">
                            {{ item }} <span v-if="item === 'YTD'">*</span>
                        </th>
                    </tr>
                    </thead>
                    <tbody data-test="distribution-table-body">
                    <tr data-test="distribution-interest">
                        <th>
                          Interest
                        </th>
                        <td v-for="interest in processData(distributions, 'interest')" class="text-right">
                            {{interest }}
                        </td>
                    </tr>
                    <tr data-test="distribution-dividends">
                        <th>
                          Canadian dividends
                        </th>
                        <td v-for="dividends in processData(distributions, 'dividends')" class="text-right">
                            {{ dividends }}
                        </td>
                    </tr>
                    <tr data-test="distribution-foreignDividends">
                        <th>
                          Foreign income
                        </th>
                        <td v-for="foreignDividends in processData(distributions, 'foreignDividends')"
                            class="text-right">
                            {{ foreignDividends }}
                        </td>
                    </tr>
                    <tr data-test="distribution-foreignTaxesPaid">
                        <th>
                          Foreign taxes paid
                        </th>
                        <td v-for="foreignTax in processData(distributions, 'foreignTax')" class="text-right">
                            {{ foreignTax }}
                        </td>
                    </tr>
                    <tr data-test="distribution-capitalGains">
                        <th>
                          Capital gains
                        </th>
                        <td v-for="capitalGains in processData(distributions, 'capitalGains')" class="text-right">
                            {{ capitalGains }}
                        </td>
                    </tr>
                    <tr data-test="distribution-returnOfCapital">
                        <th>
                          Return of capital
                        </th>
                        <td v-for="returnCapital in processData(distributions, 'returnCapital')" class="text-right">
                            {{ returnCapital }}
                        </td>
                    </tr>
                    <tr data-test="distribution-total">
                        <th>
                          Total distributions
                        </th>
                        <td v-for="total in processData(distributions, 'total')" class="text-right">
                            {{ total}}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <p class="disclaimer" data-test="distribution-disclaimer">* Distributions are characterized into income type at year-end and the total includes all distributions declared year-to-date.</p>
        </article>

    </Teleport>
</div>

