                                    <a :href="legalLink.value"
                                       :class="{'link-ext': legalLink.value.startsWith('http')}"
                                       :target="legalLink.value.startsWith('http') ? '_blank' : false"
                                    >
                                        {{legalLink.key}}
                                    </a>
                                </li>
                            </template>
                        </ul>
                    </div>
                    <div class="col-lg-3 mt-lg-0 mt-2 d-flex align-items-center justify-content-end">                        <ul class="list-inline footer-social-list ">                                                        <li class="footer-social-item">                                  <a                                                                                 href="https://twitter.com/rbcgamnews"                                                                                 target="_blank"                                             rel="noreferrer"                                            aria-label="Twitter"
