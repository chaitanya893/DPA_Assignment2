<script type="module">
    import {createApp} from "vue"
    import {
        RbcButton, RbcIcon
    } from "wm"

    const footerObj = {"menu":[{"header":"Products","links":[{"key":"Mutual funds","value":"/en/ca/products/mutual-funds/"},{"key":"RBC  ishare ETFs","value":"/en/ca/products/etfs/index"},{"key":"Alternative investments","value":"/en/ca/products/alternative-investments/"}]},{"header":"Investor information","links":[{"key":"Fund facts (mutual funds)","value":"/en/ca/products/mutual-funds/?tab=documents&fundfacts=true"},{"key":"Fund facts (ETFs)","value":"/en/ca/products/etfs/index?tab=documents&fundfacts=true"},{"key":"PFIC reporting","value":"/en/ca/products/pfic-reporting"},{"key":"Regulatory documents","value":"/en/ca/products/financial-reports-prospectuses"},{"key":"Fund governance","value":"/en/ca/products/fund-governance/"},{"key":"Proxy voting","value":"/en/ca/products/proxy-voting/"},{"key":"Unclaimed property","value":"/en/ca/products/unclaimed-property"},{"key":"Important investor information","value":"/en/ca/products/important-investor-information"}]},{"header":"About RBC GAM","links":[{"key":"Our story","value":"/en/global/corporate-story/"},{"key":"Media centre","value":"/en/ca/about-us/news-releases"},{"key":"Contact us","value":"/en/ca/about-us/contact-us"},{"key":"Careers","value":"https://jobs.rbc.com/ca/en"}]},{"header":"Investing","links":[{"key":"Ready to invest?","value":"/en/ca/about-us/ready-to-invest"}]}],"legal":{"copyright":"<sup>®<\/sup> / <sup>TM<\/sup> Trademark(s) of Royal Bank of Canada. Used under licence. iSHARES is a registered trademark of BlackRock, Inc., or its subsidiaries in the United States and elsewhere. Used under licence. © 2026 RBC Global Asset Management Inc. and BlackRock Asset Management Canada Limited. All rights reserved.","legalLinks":[{"key":"Privacy & security","value":"https://www.rbc.com/privacysecurity/"},{"key":"Legal","value":"https://www.rbc.com/legal/"},{"key":"Accessibility","value":"/en/ca/about-us/accessibility"},{"key":"Terms and conditions","value":"/en/ca/terms-and-conditions"},{"key":"Advertising & Cookies","value":" "},{"key":"About RBC","value":"https://www.rbc.com/"}],"socialLinks":[{"key":"linkedin-in","value":"https://linkedin.com/company/rbc-global-asset-management"}]}};

    createApp({
        data() {
            return {
                footerMenuArray: footerObj.menu,
                footerLegal: footerObj.legal
            }
        },
        components: {
            "rbc-button": RbcButton,
            "rbc-icon": RbcIcon
        },
        computed: {
            columnWidthClass() {
                const numberOfCol = this.footerMenuArray.reduce((acc, curr) => {
                    return curr.links.length > 0 ? acc + 1 : acc;
                }, 0);
                return numberOfCol === 4 ? {'col-lg-3': true} : {'col-lg-4': true}
            }
        },
        methods: {
          handleKeydown(event) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      this.openCookieSettings(event);
    }
  },
            openCookieSettings(e) {
                e.preventDefault();
                window.OneTrust.ToggleInfoDisplay();
            }
        },
        mounted() {
        }
    }).mount('#app_id_5059317')
</script>
