    <div id="app_id_5327932" v-cloak>
    <Teleport to="#asset-mix-mf-slot">
        <div data-test="asset-type-mix-section" v-show="assetMixData && !isEmpty(assetMixData)">
            <article class="section-block section-block-sm" data-location="fund asset mix" v-if='!isEquityLongShortFund'>
                <header class="row section-block-header">
                    <h3 class="col-sm">
                        Asset type mix
                    </h3>
                    <span class="col-sm text-sm-right footnote">As of {{ assetMixAsOf }}</span>
                </header>
                <div class="row">
                    <div class="col-lg-10">
                        <div ref="chartAssetMix" id="assetMix"></div>
                    </div>
                </div>
            </article>
        </div>

        
            <div data-test="equity-vs-fixed-section"  v-if='!isEquityLongShortFund && !hideEquityVsFixedSection'>
                <article v-if="equityVsFixedEquityRatio || equityVsFixedFixedRatio" class="section-block section-block-sm"
                         data-location="fund equity vs fixed">
                    <hr class="section-block-divider">
                    <div class="progressbar-large">
                        <div class="progressbar-text">
				<span class="progressbar-text-col">
					<span class="text-number">
						{{ equityVsFixedEquityRatio }}
					</span>
					<span class="progressbar-text-float">
                        Equity
                    </span>
				</span>
                            <span class="progressbar-text-col">
					<span class="text-number">
						{{ equityVsFixedFixedRatio }}
					</span>
					<span class="progressbar-text-float progressbar-text-right">
                        Fixed Income / Cash
                    </span>
				</span>
                        </div>
                        <rbc-progressbar style="background-color: #006AC3;"
                                         :progress="equityVsFixedProgress"
                                         size="large"
                                         ref="progressBar"
                                         class="blue-progressbar-class"
                        ></rbc-progressbar>
                    </div>
                </article>
            </div>

        
        <div data-test="equity-long-short-asset-mix-section" v-if="isEquityLongShortFund && longShortAssetMixData">
            <article class="section-block section-block-sm" data-location="fund equity long short asset mix">
                <header class="row section-block-header">
                    <h3 class="col-sm">Asset type mix</h3>
                    <span class="col-sm text-sm-right footnote">As of {{ assetMixAsOf }}</span>
                </header>
                <div class="table-responsive">
                    <table class="text-right table table-compact table-border-horizontal table-transparent table-striped ls-asset-mix-table" style="min-width: 490px;">
                        <thead>
                        <tr>
                            <th aria-hidden="true"></th>
                            <th class="text-right">Long weight %</th>
                            <th class="text-right">Short weight %</th>
                            <th class="text-right">Net weight %</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr v-for="row in longShortTableRows" :key="row.key">
                            <th class="nowrap text-left">{{ row.display }}</th>
                            <td class="nowrap">{{ formatLongShortWeight(row.longWeight) }}</td>
                            <td class="nowrap">{{ formatLongShortWeight(row.shortWeight, true) }}</td>
                            <td class="nowrap">{{ formatLongShortWeight(row.netWeight) }}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

    </Teleport>
</div>

<style scoped>
    .blue-progressbar-class .rbc-progressbar-bar {
        background-color: #006AC3;
    }

    </style>

<script type="module">
    import {formatCurrency} from "utils";
    import {createApp} from 'vue'
    import {RbcProgressbar} from 'wm'

    const EQUITY_LONG_SHORT_FUNDS = ['RBF941', 'RBF441', 'RBF8257', 'RBF8258', 'RBF9941', 'RBF9441', 'RBF1441', 'RBF2941', 'RBF8358'];
    const HIDE_EQUITY_VS_FIXED_MF_FUNDS = ['RBF815', 'RBF814', 'RBF816', 'RBF820', 'RBF822', 'RBF821', 'RBF1170', 'RBF1172', 'RBF1171'];

    createApp({
        components: {
            'rbc-progressbar': RbcProgressbar
        },
        data() {
            return {
                head: 'asset type mix',
                assetMixAsOf: '',
                equityVsFixedProgress: '',
                equityVsFixedEquityRatio: '',
                equityVsFixedFixedRatio: '',
                isEquityLongShortFund: false,
                hideEquityVsFixedSection: false,
                assetMixData : null,
                longShortAssetMixData: null
            }
        },
        computed: {
            longShortTableRows() {
                if (!this.longShortAssetMixData) return [];
                const data = this.longShortAssetMixData;
                const conditionalKeys = ['Real Estate', 'Other'];
                const allCategories = [
                    { key: 'Cash',                  display: "Cash" },
                    { key: 'Fixed Income',          display: "Fixed income" },
                    { key: 'Canadian Equities',     display: "Canadian equities" },
                    { key: 'U.S. Equities',         display: "U.S. equities" },
                    { key: 'European Equities',     display: "European equities" },
                    { key: 'Asia-Pacific Equities', display: "Asia-Pacific equities" },
                    { key: 'EM Equities',           display: "Emerging markets equities" },
                    { key: 'Real Estate',           display: "Private markets" }, // Real Estate was renamed to Private markets
                    { key: 'Other',                 display: "Other" }
                ];
                return allCategories
                        .filter(cat => {
                            if (!conditionalKeys.includes(cat.key)) return true;
                            const row = data[cat.key];
                            if (!row) return false;
                            return this.isNonZeroAfterRounding(row.longWeight) || this.isNonZeroAfterRounding(row.shortWeight) || this.isNonZeroAfterRounding(row.netWeight);
                        })
                        .map(cat => ({
                            ...cat,
                            longWeight:  data[cat.key] ? data[cat.key].longWeight  : null,
                            shortWeight: data[cat.key] ? data[cat.key].shortWeight : null,
                            netWeight:   data[cat.key] ? data[cat.key].netWeight   : null
                        }));
            }
        },
        methods: {
            isEmpty(obj) {
                if (Array.isArray(obj)) {
                    return obj.length === 0;
                } else if (obj && typeof obj === 'object') {
                    return Object.keys(obj).length === 0;
                }
                return !obj;
            },
            isNonZeroAfterRounding (value) {
                return typeof value === 'number' && parseFloat(value.toFixed(1)) !== 0;
            },
            convertDate (date)
            {
                return new Date(date).toLocaleString("en-us", {
                    year: 'numeric',
                    month: 'numeric',
                    day: 'numeric',
                    timeZone: 'UTC'
                });
            },
            equityVsFixedFormatData(data) {
                this.equityVsFixedProgress = data.equityRatio;
                this.equityVsFixedEquityRatio = formatCurrency(data.equityRatio, 'en', 1, '%');
                this.equityVsFixedFixedRatio = formatCurrency(data.fixedIncomeRatio, 'en', 1, '%');
            },

            formatLongShortWeight(value, isShort) {
                if (value === null || value === undefined) {
                                            return '0.0';
                                    }
                const formatted = formatCurrency(value, 'en', 1, '');
                if (isShort && (formatted === '-0,0' || formatted === '-0.0')) {
                    return formatted.slice(1);
                }
                return formatted;
            },
            assetMixCreateChart(data, rbcFundCode) {
                var assets = [
                    {
                        key: "Cash",
                        display: "Cash"
                    },
                    {
                        key: "Fixed Income",
                        display: "Fixed income"
                    },
                    {
                        key: "Canadian Equities",
                        display: "Canadian equities"
                    },
                    {
                        key: "U.S. Equities",
                        display: "U.S. equities"
                    },
                    {
                        key: "European Equities",
                        display: "European equities"
                    },
                    {
                        key: "Asia-Pacific Equities",
                        display: "Asia-Pacific equities"
                    },
                    {
                        key: "Emerging Markets Equities",
                        display: "Emerging markets equities"
                    }

                ];

                if (data['Real Estate']) {
                    assets.push({
                        key: "Real Estate",
                        display: "Private markets" // Real Estate was renamed to Private markets
                    });
                }

                const hasOtherValue = this.isNonZeroAfterRounding(data['Other']);

                if (hasOtherValue) {
                    assets.push({
                        key: "Other",
                        display: "Other"
                    });
                }

                var pieSlices = assets.map(function (asset) {
                    return [
                        asset.display,
                        (typeof data[asset.key] === 'number' && data[asset.key] !== 0)
                                ? data[asset.key]
                                : 0
                    ];
                });

                const formatterFunction = function(point, screenReader) {
                    const currency = formatCurrency(point.y, 'en', 1, '%');
                    return screenReader ? `${point.name} ${currency}` : '<span class="header-caps" style="fill: currentColor">' + point.name + '</span><br/>' +
                            `<span style="fill:' + point.color + '">\u25CF </span><span class="strong" style="fill: currentColor">` + currency + '</span>';
                };

                if (typeof this.$refs.chartAssetMix != "undefined") {
                    this._chart = Highcharts.chart(this.$refs.chartAssetMix, {
                        accessibility: {
                            description: `This chart displays asset mix data for the RBC fund ${rbcFundCode}`,
                            keyboardNavigation: {
                                order: ["container", "series", "legend"]
                            },
                            point: {
                                descriptionFormatter: function(point) {
                                    return formatterFunction(point, true);
                                }
                            }
                        },
                        chart: {
                            type: 'pie',
                        },
                        legend: {
                            align: 'right',
                            layout: 'vertical',
                            verticalAlign: 'middle',
                            useHTML: true,
                            maxHeight: '350px',
                            labelFormatter: function () {
                                return '<div class="row" style="min-width: 285px"><div class="col" style="white-space: normal">'
                                        + this.name
                                        + '</div><div class="col flex-grow-0">'
                                        + formatCurrency(this.y, 'en', 1, '%')
                                        + '</div></div>'
                            }
                        },
                        tooltip: {
                            pointFormat: '{point.y:.1f}%',
                            formatter: function () {
                                return formatterFunction(this.point);
                            }
                        },
                        series: [
                            {
                                name: 'Percents',
                                data: pieSlices
                            }
                        ],
                        responsive: {
                            rules: [{
                                condition: {
                                    maxWidth: 480
                                },
                                chartOptions: {
                                    chart: {
                                        height: 500
                                    },
                                    legend: {
                                        margin: 10,
                                        align: 'center',
                                        verticalAlign: 'bottom',
                                        x: 0,
                                        y: 0
                                    }
                                }
                            },
                                {
                                    condition: {
                                        minWidth: 481
                                    },
                                    chartOptions: {
                                        chart: {
                                            height: hasOtherValue ? '60%' : '55%'
                                        }
                                    }
                                }]
                        }
                    });

                    const label = 'Asset type mix';
                    const rootElem = document.getElementById("assetMix");
                    rootElem.setAttribute("aria-label", label + ' - Interactive Chart Root');
                    rootElem.querySelector(".highcharts-container").setAttribute("aria-label", label + ' - Interactive Chart Container');
                    rootElem.querySelector("svg").setAttribute("aria-label", label + ' - Interactive Chart');
                    rootElem.querySelector(".highcharts-container").setAttribute("role", 'region');
                    rootElem.querySelector(".highcharts-exit-anchor").setAttribute("role", "region");
                    rootElem.querySelector(".highcharts-exit-anchor").setAttribute("aria-label", label + ' - Interactive Chart End');
                }
                this.fundData = "no bundle";
            }
        },

