            // Custom benchmark for RBF820
    if (parentCode === 'RBF820') {
        this.fundBenchmark = [
            {
                value: '60%',
                description: 'S&P/TSX Capped Composite Total Return Index'
            },
            {
                value: '40%',
                description: 'S&P 500 Total Return Index (50% Hedged to CAD)'
            }
        ];
    } else if (fundData.benchmark && fundData.benchmark['en'].length) {
        this.fundBenchmark = fundData.benchmark['en'].map(function(item) {
            var displayPercent = item.indexOf('%') <= 6 && item.indexOf('%') >= 0;

            if (displayPercent) {
                var split = item.split('% ');
                var percent = ('en' === 'fr') ? ' %' : '%';
                var numericValue = Number(split[0]);

                return {
                    value: Number.isInteger(numericValue)
                        ? numericValue + percent
                        : numericValue.toString() + percent,
                    description: split[1]
                };

            } else {
                return {
                    description: item
                };
            }
        });
    }
},
        beforeUnmount() {
            window.removeEventListener('resize', this.checkIsMd);
        }
    }).mount(`#app_id_3359602`);
