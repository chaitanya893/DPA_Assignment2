      <div id="addToThemeRoot" class="container"></div>
  <div id="app_id_6723972" v-cloak>
    <Teleport to="#addToThemeRoot">
        <div v-cloak>
            <rbc-modal
                    :active="themeModalOpen"
                    button-cancel="Cancel"
                    title="Add to theme(s)"
                    button-size="medium"
                    @toggle="toggleThemeModal"
            >

                <p class="well bold px-1 py-1 mb-1">{{ themeModalContentToAdd.name }}</p>
                <rbc-tab class="mb-1" toggle-show @tabupdate="themeModalTabUpdate($event.active)">
                    <rbc-tab-content id="existing-themes" name="Existing Themes">
                        <h4>Add to existing theme</h4>
                        <rbc-multiselect
                                label="Existing Themes"
                                id="themeMultiselect"
                                v-model="themeModalMyThemesSelect"
                                checked-text="checked"
                                placeholder="Choose"
                        ></rbc-multiselect>
                    </rbc-tab-content>
                    <rbc-tab-content id="new-theme" name="New Theme">
                        <h4>Add to new theme?</h4>
                        <rbc-input
                                id="themeNewTheme"
                                label="New Theme"
                                type="text"
                                class="mb-1"
                                v-model="themeModalNewThemeName"
                        ></rbc-input>
                    </rbc-tab-content>
                </rbc-tab>
                <a href="/en/ca/advisor-support/themes/how-themes-work" target="_blank"
                   class="link-ext">Need help using Themes?</a>
                <template #buttons>
                    <rbc-button
                            @click="themeModalAddContent"
                    >
                      Save
                    </rbc-button>
                </template>
            </rbc-modal>
        </div>
    </Teleport>
</div>
<script type="module">
    import {
        fetchedThemeData$
    } from "vite-esm/add-to-theme.service.js";
    import {createApp} from "vue"
    import {
        RbcModal, RbcTab, RbcTabContent, RbcMultiselect, RbcInput, RbcButton, RbcAlert
    } from "wm"

    createApp({
        created() {
            fetchedThemeData$.subscribe(httpResponse => {
                if (!httpResponse) { return; }
                this.updateContentToAdd(httpResponse.getContentData);
                this.updateMyThemesSelect(httpResponse.getMyThemesData);
                this.themeModalOpen = true;
            });
        },
        components: {
            'rbc-modal': RbcModal,
            'rbc-tab': RbcTab,
            'rbc-tab-content': RbcTabContent,
            'rbc-multiselect': RbcMultiselect,
            'rbc-input': RbcInput,
            'rbc-button': RbcButton,
            'rbc-alert': RbcAlert
        },
        data() {
            return {
                themeModalNewThemeName: null,
                themeModalMyThemesSelect: [],
                themeModalOpen: false,
                themeModalContentToAdd: {},
                themeModalCurrentTab: "existing-themes",
            }
        },
        methods: {
            toggleThemeModal() {
                this.themeModalOpen = !this.themeModalOpen;
            },
            themeModalTabUpdate(tabId) {
                this.themeModalCurrentTab = tabId;
            },
            updateContentToAdd(data) {
                if (!data) { return; }
                this.themeModalContentToAdd = {
                    identifier: data.identifier,
                    name: data.name,
                    languageId: data.languageId,
                }
            },
            updateMyThemesSelect(data) {
                this.themeModalMyThemesSelect = (data && data.themes) ? data.themes.map(el => {
                    let selected = (el.listOfIdentifiers.indexOf(this.themeModalContentToAdd.identifier) !== -1);
                    return {
                        label: el.name,
                        value: el.identifier,
                        selected: selected,
                        disabled: selected,
                        listOfIdentifiers: el.listOfIdentifiers,
                        languageId: el.languageId
                    };
                }) : [];
            },
            themeModalAddContent() {
                if (this.themeModalCurrentTab === "existing-themes") {
                    this.updateSelectedThemes();
                } else {
                    this.addNewTheme();
                }
            },
            updateSelectedThemes() {
                if (!!this.themeModalMyThemesSelect) {
                    const selectedThemes = this.themeModalMyThemesSelect.filter(({selected}) => selected)
                    selectedThemes.forEach(el => {
                        const listOfIdentifiers = [].concat(el.listOfIdentifiers.split(','));
                        if (listOfIdentifiers.indexOf(this.themeModalContentToAdd.identifier) === -1) {
                            listOfIdentifiers.push(this.themeModalContentToAdd.identifier);
                        }
                        const url = '/ca/contentletapi?identifier=' + el.value + '&languageId=' + el.languageId + '&action=UPDATE&listOfIdentifiers=' + listOfIdentifiers;
                        fetch(url)
                                .then(function (response) {
                                    if (response.status === 200) {
                                        return response.json();
                                    } else {
                                        console.error('Error trying to update content httpStatus:' + response.status);
                                    }
                                })
                                .then(function (data) {
                                    console.log(data);
                                })
                                .catch(function (e) {
                                    console.error(e);
                                });
                    })
                    this.toggleThemeModal();
                }
            },
            addNewTheme() {
                var name = encodeURIComponent(this.themeModalNewThemeName);
                var uniqueId = (new Date()).getTime();
                var url = '/ca/contentletapi?action=CREATE&contentType=Themes&languageId=' + this.themeModalContentToAdd.languageId + '&advisorId=${advisorID}&uniqueidentifier=' + uniqueId + '&name=' + name + '&listOfIdentifiers=' + this.themeModalContentToAdd.identifier;
                fetch(url)
                        .then(function (response) {
                            if (response.status !== 200) {
                                throw new Error('Error while creating new theme httpStatus:' + response.status);
                            } else {
                                return response.json();
                            }
                        })
                        .then(function (data) {
                            console.log(data);
                        })
                        .catch(function (e) {
                            console.error(e);
                        });
                this.toggleThemeModal();
            }
        },
        mounted() {
        },
        unmount() {
            fetchedThemeData$.unsubscribe();
        }
    }).mount('#app_id_6723972')
</script>







