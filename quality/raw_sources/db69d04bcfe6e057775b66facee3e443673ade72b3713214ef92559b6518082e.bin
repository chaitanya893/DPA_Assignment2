<div id="app_id_3663138" v-cloak>
        <Teleport to="#calendar-return-mf-slot">




   <div data-test="calendar-return-section">
        <article class="section-block section-block-sm" data-location="fund calendar return">
            <header class="row section-block-header">
                <h3 class="col-sm">Calendar returns %</h3>
                <span class="col-sm text-sm-right footnote">As of {{ calendarReturnsAsOf }}</span>  
            </header>


            
            <div ref="chartCalendarReturns" id="calendarReturns"></div>
        </article>
    </div>
</Teleport>
</div>



<script type="module">

 import {
        formatCurrency,
        formatNumber
    } from "utils";

    import {createApp} from 'vue'
    const app = createApp({
        data() {
            return {
                head: 'calendar returns',
                calendarReturnsAsOf: '',
                calendarReturnsAsOfDate: new Date(),
                isVirtualClassFund:null
            }
        },
        methods: {
            calendarReturnsCreateChart(data) {
                var _self = this;
           
                var returns =      {
                    ...data.calendarReturn,
                    YTD: data.calendarReturn.YTD
                };
                var rankings = data.calendarYearRanking;
                // var currentYear = new Date().getFullYear();
                var rbcFundCode = data.rbcFundCode;

                var sortedYearKeys = Object.keys(returns).sort(function (a, b) {
                    if (a === 'YTD') {
                        return 1;
                    } else if (b === 'YTD') {
                        return -1;
                    } else {
                        var newA = parseInt(a.replace('Year', ''));
                        var newB = parseInt(b.replace('Year', ''));
                        return newB - newA;
                    }
                });

                const formatterFunction = function(point) {
                    var quartile = rankings && rankings[point.category[1]] ? 'Quartile: <span class="strong" style="fill: currentColor">' + _self.formatQuartile(rankings[point.category[1]]) + '</span>' : '';
                             return '<span class="header-caps" style="fill: currentColor">' + point.category[0] + '</span><br/>' +
                                     point.series.name + ': <span class="strong" style="fill: currentColor">' + formatCurrency(point.y, 'en', 1, '%') + '</span><br/>' +
                                     quartile;
                };

                // Please remove this block after January 31 
                //FYI Charles
                
                 //sortedYearKeys.splice(sortedYearKeys.indexOf("Year1"),1);

                // End of the block
                const date = this.calendarReturnsAsOfDate;
                const year = date.getFullYear();
                const isDec31 = date.getMonth() === 11 && date.getDate() === 31;
                const yearShift = isDec31 ? 1 : 0;

                if (!returns['YTD'] || isDec31) {
                    sortedYearKeys.pop();
                }

                var sortedYAxisBars = sortedYearKeys.map(function (key) {
                    return returns[key];
                })

                var sortedXAxis = sortedYearKeys.map((key) => {
                    if (key === 'YTD') {
                        return ['YTD', key];
                    } else {
                        const yearNumber = parseInt(key.replace('Year', '')) - yearShift;
                        return [year - yearNumber, key];
                    }
