<script type="module">
    import { createApp } from 'vue';
    import {RbcTab,RbcTabContent} from 'wm'

    const EQUITY_LONG_SHORT_FUNDS = ['RBF941', 'RBF441', 'RBF8257', 'RBF8258', 'RBF9941', 'RBF9441', 'RBF1441', 'RBF2941', 'RBF8358'];

    createApp({
        data() {
            return {
                isMd: false,
                showall:'Show all',
                fdsFundData:null,
                templateId: null,
                      result: null

            };
        },
        components: {
            'rbc-tab': RbcTab,
            'rbc-tab-content': RbcTabContent
        },
        methods: {
            triggerTimeout() {
                setTimeout(() => {
                    this.result = true; 
                }, 0);
        },
  isEmpty(obj) {

    if (Array.isArray(obj)) {
      return obj.length === 0;
    } else if (obj && typeof obj === 'object') {
    if (Object.keys(obj).length === 0) {
      return true; // Object is empty
    }

    for (const key in obj) {
      if (obj[key] === 0) {
        return true;
      }
    }
    
    return false; 
  }
    return !obj;
  }
},
computed: {
  isPortfolioAnalyisisDataExist() {

  const assetMixSection = this.isEmpty(this.fdsFundData?.assetMix);

  const sectorAllocationSection = this.isEmpty(this.fdsFundData?.bondSectorAllocationRBC) && this.isEmpty(this.fdsFundData?.equitySectorAllocation);

  const top10UnderlyingSection =  this.isEmpty(this.fdsFundData?.topUnderlyingHoldings);

  const topHoldingsSection = this.isEmpty(this.fdsFundData?.topHoldings);

  const geographicAllocationSection = this.isEmpty(this.fdsFundDatata?.countryAllocation);

  const termToMaturitySection = this.isEmpty(this.fdsFundData?.termToMaturity);

  const bondRating = this.isEmpty(this.fdsFundData?.creditRating);
  
  const equiltyCharacteristicsSection =  this.isEmpty(this.fdsFundData?.dividendYield) &&  this.isEmpty(this.fdsFundData?.pbRatio) &&  this.isEmpty(this.fdsFundData?.peRatio) && this.isEmpty(this.fdsFundData?.avgMktCap);

    if (this.templateId == 'portfolio') {
      return !(assetMixSection && sectorAllocationSection && equiltyCharacteristicsSection && termToMaturitySection && geographicAllocationSection && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId == 'equity-multiregion')
    {
      if (this.fdsFundData && EQUITY_LONG_SHORT_FUNDS.includes(this.fdsFundData.rbcFundCode)) return true;
      return !(assetMixSection && sectorAllocationSection &&  equiltyCharacteristicsSection && geographicAllocationSection && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId === 'equity-singleregion') {
      return !(assetMixSection && sectorAllocationSection &&  equiltyCharacteristicsSection && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId === 'balanced') {
      return !(assetMixSection && sectorAllocationSection &&  equiltyCharacteristicsSection && topHoldingsSection && geographicAllocationSection);
    }

    if (this.templateId === 'fixedincome-multiregion') {
      return !(assetMixSection && sectorAllocationSection && bondRating && termToMaturitySection && geographicAllocationSection && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId === 'fixedincome-singleregion') {
      return !(assetMixSection && sectorAllocationSection && bondRating && termToMaturitySection && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId === 'moneymarket') {
      return !(assetMixSection && sectorAllocationSection && termToMaturitySection && bondRating && topHoldingsSection && top10UnderlyingSection);
    }

    if (this.templateId === 'balanced-fi-singleregion') {
      return !(assetMixSection && sectorAllocationSection  &&  equiltyCharacteristicsSection && bondRating && termToMaturitySection && topHoldingsSection);
    }

    if (this.templateId === 'balanced-fi-multiregion') {
      return !(assetMixSection && sectorAllocationSection  &&  equiltyCharacteristicsSection && bondRating && termToMaturitySection && topHoldingsSection && geographicAllocationSection && top10UnderlyingSection);
    }
    if (this.templateId === 'portfolio-fi-multiregion') {
      return !(assetMixSection && sectorAllocationSection &&  equiltyCharacteristicsSection && bondRating && termToMaturitySection && geographicAllocationSection && topHoldingsSection && top10UnderlyingSection);
    }
    if (this.templateId === 'region-fx') {
        return !(assetMixSection && sectorAllocationSection && topHoldingsSection && top10UnderlyingSection)
    }

    return true;
  }
},
