                        </tr>

                        <tr style="height:11pt;">

                           <td style="background-color:azure;border-bottom:0.5pt solid #000000;padding-bottom:1.625pt;padding-top:1.625pt;vertical-align:Bottom;width:105.5pt;">

                              <div style="line-height:11.0pt;text-align:left;">

                                 <div style="margin-right:9.5pt;text-align:Left;white-space:nowrap;"><font style="color:#000000;font-family:Arial;font-size:8pt;margin-left:0.0pt;">Highest</font></div>
                              </div>
                           </td>

                           <td style="background-color:azure;border-bottom:0.5pt solid #000000;padding-bottom:1.625pt;padding-top:1.625pt;vertical-align:Bottom;white-space:nowrap;width:115pt;">

                              <div style="line-height:11.0pt;margin-left:9.5pt;margin-right:9.5pt;text-align:right;width:96pt;">

                                 <div style="display:flex;margin:auto;width:24.67pt;">

                                    <div style="display:flex;white-space:nowrap;width:24.67pt;"><font style="color:#000000;font-family:Arial;font-size:8pt;width:24.67pt;">18.65</font></div>

                                    <div style="display:flex;"><font style="color:#000000;font-family:Arial;font-size:8pt;width:auto;">%</font></div>
                                 </div>
                              </div>
